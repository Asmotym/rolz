# Minimal configuration
VITE_BACKEND_URL=http://localhost:4000
VITE_PUBLIC_API_BASE_URL=http://localhost:4000/api
VITE_API_DOCS_URL=http://localhost:6060
API_DOCS_BASE_URL=http://localhost:4000/api
API_DOCS_HOST_PORT=6060
ENVIRONMENT=development

# Backend server
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (Docker defaults)
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=
DATABASE_URL=
DATABASE_SSL=false

# Discord
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://localhost:5173
OWNER_DISCORD_USER_ID=

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-only secret: provide from the shell/secret manager, not this file in production.
SENTRY_AUTH_TOKEN=
# Defaults to 0.1 in production and 1.0 in development.
SENTRY_TRACES_SAMPLE_RATE=
